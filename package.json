{
  "name": "lodgical",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A small travel booking application",
  "license": "ISC",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"pnpm:dev:api\" \"pnpm:dev:web\"",
    "dev:web": "pnpm --filter @lodgical/web dev",
    "dev:api": "pnpm --filter @lodgical/api dev",
    "build": "pnpm --filter @lodgical/shared build && pnpm --filter @lodgical/api build && pnpm --filter @lodgical/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:netlify": "pnpm --package=netlify-cli@27.1.2 dlx netlify build --filter @lodgical/web --offline && node scripts/verify-netlify-function.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lighthouse": "pnpm --filter @lodgical/web lighthouse",
    "fallow": "fallow",
    "fallow:audit": "fallow audit"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fallow": "^3.16.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2"
  }
}
